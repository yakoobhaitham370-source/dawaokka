      "css": ".ds-button-danger{font-family:'Cairo',sans-serif;min-height:44px;padding:9px 19px;border:0;border-radius:12px;display:inline-flex;align-items:center;justify-content:center;gap:8px;font-size:12px;font-weight:700;line-height:1.7;cursor:pointer;transition:background .18s;background:#b7283c;color:#fff;}.ds-button-danger:hover{background:#b7283c;color:#fff}.ds-button-danger:focus-visible{outline:3px solid #9088ff;outline-offset:3px}.ds-button-danger:disabled{opacity:.46;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-button-danger{transition:none}}"
    },
    {
      "name": "Labeled Field",
      "kind": "input",
      "refersTo": "input",
      "description": "Quiet filled field with visible label and observed focus treatment.",
      "html": "<label class=\"ds-field\" dir=\"rtl\"><span>اسم المراجع</span><input aria-label=\"اسم المراجع\" placeholder=\"الاسم الكامل\"></label>",
      "css": ".ds-field{font-family:'Cairo',sans-serif;display:flex;flex-direction:column;gap:7px;font-size:12px;font-weight:600;min-width:0}.ds-field>span{color:#5d5873}.ds-field input{font:inherit;font-size:14px;font-weight:400;border:1px solid #e8e6f1;background:#f7f7fc;border-radius:12px;padding:12px 14px;min-height:46px;color:#29263e;min-width:0;caret-color:var(--purple,#4f46e5)}.ds-field input:focus,.ds-field input:focus-visible{border-color:#8e81ef;outline:2px solid #e6e1ff}@media(max-width:620px){.ds-field input{font-size:16px}}"
    },
    {
      "name": "Navigation",
      "kind": "nav",
      "refersTo": "nav-active",
      "description": "RTL navigation with purple selection, becoming locally scrollable pills at the tablet boundary.",
      "html": "<nav class=\"ds-nav\" aria-label=\"مساحة العمل\" dir=\"rtl\"><a class=\"ds-active\" href=\"#patients\" aria-current=\"page\">المراجعون</a><a href=\"#dispense\">صرف العلاج</a><a href=\"#allergies\">صندوق الحساسية</a></nav>",
      "css": ".ds-nav{font-family:'Cairo',sans-serif;display:grid;gap:5px}.ds-nav a{display:flex;align-items:center;gap:12px;padding:11px 15px;border-radius:13px;color:#66647d;font-size:13px;font-weight:600;min-height:44px;text-decoration:none}.ds-nav a:hover{background:#f5f4ff}.ds-nav a.ds-active{background:var(--purple,#4f46e5);color:white}.ds-nav a:focus-visible{outline:3px solid #9088ff;outline-offset:3px}@media(max-width:850px){.ds-nav{display:flex;gap:8px;overflow:auto}.ds-nav a{white-space:nowrap;background:white;border-radius:25px;padding:8px 18px;font-size:12px;font-weight:700}}"
    },
    {
      "name": "Allergy History Badges",
      "kind": "chip",
      "refersTo": "badge-unknown",
      "description": "Explicit unknown-history caution and documented no-known-allergy status, shown together for comparison.",
      "html": "<div class=\"ds-badges\" dir=\"rtl\"><span class=\"ds-badge ds-unknown\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M12 22s8-4 8-11V5l-8-3-8 3v6c0 7 8 11 8 11Z\"/><path d=\"M12 8v4m0 4h.01\"/></svg>تاريخ الحساسية غير معروف</span><span class=\"ds-badge ds-none\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M12 22s8-4 8-11V5l-8-3-8 3v6c0 7 8 11 8 11Z\"/><path d=\"M12 8v4m0 4h.01\"/></svg>لا توجد حساسية معروفة — موثق</span></div>",
      "css": ".ds-badges{display:flex;gap:12px;flex-wrap:wrap;font-family:'Cairo',sans-serif}.ds-badge{display:inline-flex;align-items:center;gap:5px;padding:4px 10px;font-size:10px;border-radius:8px;font-weight:700;line-height:1.8;width:fit-content}.ds-unknown{background:#fff1ce;color:#8a5700}.ds-none{background:#dff7ef;color:#007d70}"
    },
    {
      "name": "Working Panel",
      "kind": "card",
      "refersTo": "panel",
      "description": "Rounded white work surface with tonal separation and no shadow.",
      "html": "<section class=\"ds-panel\" dir=\"rtl\"><h2>رعاية مستمرة. كل يوم</h2><p>ابدأ بمراجعة ملفات المراجعين وخطوتهم التالية.</p></section>",
      "css": ".ds-panel{font-family:'Cairo',sans-serif;background:white;color:#202234;border-radius:var(--radius,24px);padding:24px;min-width:0}.ds-panel h2{font-size:19px;font-weight:800;margin:0 0 16px}.ds-panel p{font-size:12px;line-height:1.9;margin:0;color:var(--muted,#65677c)}@media(max-width:1150px){.ds-panel{padding:20px}}@media(max-width:620px){.ds-panel{border-radius:22px;padding:21px}.ds-panel h2{font-size:17px}}"
    },
    {
      "name": "Teal Statistic Card",
      "kind": "custom",
      "description": "Corrected dark teal operational metric with white value and soft supporting text.",
      "html": "<button class=\"ds-stat\" dir=\"rtl\"><span>المراجعون</span><strong>12</strong><small>مسجل في الصيدلية</small></button>",
      "css": ".ds-stat{font-family:'Cairo',sans-serif;border:0;border-radius:23px;min-height:183px;text-align:start;padding:23px;background:#007f7f;color:white;overflow:hidden;cursor:pointer}.ds-stat>span{font-weight:700;font-size:14px}.ds-stat>strong{font-size:42px;line-height:1.6;display:block;font-weight:800;margin-top:4px;font-variant-numeric:tabular-nums}.ds-stat>small{color:#defffb;font-size:10px}.ds-stat:focus-visible{outline:3px solid #9088ff;outline-offset:3px}@media(max-width:1150px){.ds-stat{padding:18px;min-height:166px}.ds-stat>span{font-size:12px}.ds-stat>small{font-size:9px}}@media(max-width:620px){.ds-stat{padding:19px;min-height:171px;border-radius:24px}.ds-stat>strong{font-size:38px;margin-top:10px}.ds-stat>small{font-size:8px}}"
    }
  ],
  "narrative": {
    "northStar": "Riaya — continuous care, every day",
    "overview": "Riaya is an Arabic-first operational workspace for Iraqi community pharmacists. Its established visual world follows the supplied dawaok.com mobile references: Cairo typography, confident purple, teal accents, pale lavender surroundings, rounded white working panels, pill tabs and line icons. The current surfaces use Operate mode: scanability, patient identity and clear next actions lead.\n\nThe full-screen application defaults to Arabic RTL and mirrors to English LTR through logical layout properties. Preserve the established brand and panel language when extending the recovered implementation. The frontmatter records actual stylesheet values; it does not establish a new direction.",
    "keyCharacteristics": [
      "Arabic RTL first, with mirrored English support.",
      "Rounded, reference-led working panels and restrained depth.",
      "Purple action hierarchy with teal continuity cues.",
      "Explicit clinical status text and icons alongside color.",
      "Responsive grids, stacked phone content and locally scrollable tabs."
    ],
    "rules": [
      {
        "name": "The Explicit History Rule",
        "body": "Unknown allergy history must retain its caution treatment and explicit label. An empty record must never visually imply documented no known allergies.",
        "section": "colors"
      }
    ],
    "dos": [
      "Do preserve Cairo, Arabic RTL defaults and mirrored LTR layout.",
      "Do use the actual CSS palette and dedicated dark teal statistic token.",
      "Do keep the clinical safety footnote at its dedicated color and (12px) size.",
      "Do pair clinical color with explicit status text and icons.",
      "Do keep unknown history visually distinct from documented no known allergies.",
      "Do stack working content on phones and contain tab scrolling locally."
    ],
    "donts": [
      "Don't replace the rounded Riaya panels or purple/teal identity during refinement.",
      "Don't use bright brand teal behind the corrected white statistic text.",
      "Don't infer no known allergies from an empty record.",
      "Don't add decorative shadows to ordinary working panels.",
      "Don't treat the scoped ship disposition as overall clinical or production validation."
    ]
  }
